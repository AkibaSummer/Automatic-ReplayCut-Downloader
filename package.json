{
  "name": "automatic-replaycut-downloader-desktop",
  "private": true,
  "version": "0.3.9",
  "description": "Electron + React desktop app for Bilibili replay management",
  "main": "electron-dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && electron -r tsx electron/src/main.ts",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm --prefix frontend run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test": "node electron/tests/run-all.cjs",
    "verify": "npm run build && npm test",
    "dist": "npm run build && electron-builder --win dir",
    "start": "electron ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "music-metadata": "^11.12.3",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.akibasummer.replaymanager",
    "productName": "随缘公会工作台",
    "directories": {
      "output": "release\\electron"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "electron-dist/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/{test,tests,__tests__,spec,example,examples}/**",
      "!**/*.{md,map,d.ts}",
      "!**/CHANGELOG*",
      "!**/README*",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/sql-wasm-debug*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/music-metadata/test/**"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
