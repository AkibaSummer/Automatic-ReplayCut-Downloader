{
  "name": "automatic-replaycut-downloader-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Electron + React desktop app for Bilibili replay management",
  "main": "electron-dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && tsx electron/src/main.ts",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm --prefix frontend run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dist": "npm run build && electron-builder --win portable",
    "start": "electron ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "mp4-muxer": "^5.2.2",
    "music-metadata": "^11.12.3",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.akibasummer.replaymanager",
    "productName": "Replay Manager",
    "directories": {
      "output": "release\\electron"
    },
    "asar": true,
    "files": [
      "electron-dist/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "ReplayManager-Portable.exe"
    }
  }
}
